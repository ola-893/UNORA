# Copy to .env locally. Never commit keys, proofs, or account data.
MONAD_TESTNET_CHAIN_ID=10143
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
# Replace RPC with your Alchemy endpoint to demonstrate Alchemy usage later.
DEPLOYER_ADDRESS=
# Optional; omit these two variables to default to DEPLOYER_ADDRESS.
# Use the Mera-derived governing account as root when available.
# ROOT_CONTROLLER_ADDRESS=
# ORACLE_WRITER_ADDRESS=
ATTESTATION_REGISTRY_ADDRESS=
CREDIT_LINE_ADDRESS=
COLLATERAL_TOKEN_ADDRESS=
LOAN_TOKEN_ADDRESS=

# Use a Foundry keystore for milestone-1 transaction signing.
# App ID is public. The secret previously pasted in chat should be rotated.
RECLAIM_APP_ID=0xB371754c00E20D6d72C07b57Cd2Ee79eaa32B1ea
RECLAIM_APP_SECRET=
RECLAIM_PROVIDER_ID=
RECLAIM_PROVIDER_VERSION=

# Later milestones only; not implemented yet.
CRE_ACCOUNT_ID=
ENVIO_GRAPHQL_ENDPOINT=http://localhost:8080/v1/graphql

# Correct TESTNET ERC-8004 deployments.
ERC8004_IDENTITY_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e
ERC8004_REPUTATION_REGISTRY=0x8004B663056A597Dffe9eCcC1965A193B7388713
REPAYMENT_VAULT_ADDRESS=
ORACLE_STATUS_ENDPOINT=
# Read-only by default. Pass --broadcast only for configured testnet writes.
ORACLE_AGENT_ID=
ORACLE_IDENTITY_STATE_FILE=deployments/oracle-identity.json
# Optional local test/demo EOA owner; must equal registry.rootController().
# For a Mera root, connect its wallet provider to synchronize() instead.
ORACLE_IDENTITY_OWNER_PRIVATE_KEY=
# Optional consent from a new EOA writer; use either key or signature+deadline.
ORACLE_WALLET_PRIVATE_KEY=
ORACLE_WALLET_SIGNATURE=
ORACLE_WALLET_SIGNATURE_DEADLINE=
# Optional historical event start for the reconciliation watcher.
# ORACLE_FROM_BLOCK=
# Earliest deployment receipt block across the configured contracts.
ENVIO_START_BLOCK=
