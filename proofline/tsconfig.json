{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "noEmit": true
  },
  "include": ["oracle-identity/**/*.ts", "frontend/**/*.ts", "frontend/**/*.tsx", "tests/**/*.ts", "indexer/write-config.ts", "indexer/reducers.ts"],
  "exclude": ["node_modules", "contracts"]
}
