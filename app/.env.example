# Unora — environment variables
# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# Privy app ID.
# Get it from https://dashboard.privy.io -> Configuration -> App settings -> App ID.
# Format looks like: clp1234abcd5678efgh9012ijkl
# The app will not start without this value.
VITE_PRIVY_APP_ID=

# Optional: Privy app client ID, only needed for multi-environment deployments.
# VITE_PRIVY_CLIENT_ID=
